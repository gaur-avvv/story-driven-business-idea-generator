# ---------------------------------------------------------------------------
# Story-Driven Business Idea Generator — server-side environment variables
# Copy to .env.local for local dev, or set these in the Render dashboard.
# These keys are read ONLY by the Express server and are never sent to the
# browser. Provider keys entered in the app's Settings modal stay in the
# browser's localStorage and are separate from these.
# ---------------------------------------------------------------------------

# Google Gemini — fallback cloud model + Gemini TTS fallback (required)
GEMINI_API_KEY=

# SerpApi — real-time web research that grounds generated ideas (optional)
# Get a key at https://serpapi.com
SERPAPI_KEY=

# ElevenLabs — natural studio narration for the story audio (optional)
# Get a key at https://elevenlabs.io
ELEVENLABS_KEY=
# Optional ElevenLabs overrides:
ELEVENLABS_MODEL=eleven_multilingual_v2

# Jan.ai — local Gemma. Point this at your Jan server's OpenAI-compatible
# endpoint (default shown). The app auto-detects reachability and falls back
# to Gemini when Jan isn't running (e.g. on Render).
JAN_BASE_URL=http://localhost:1337/v1

# Server port (Render injects this automatically)
PORT=3000
